# =====================================================================
# VISA TRACK — Environment Configuration Template (.env.example)
# =====================================================================

NOTIFICATION_ENV=development

APP_NAME="VISA TRACK — Global Visa Management Portal"
COMPANY_NAME="MS Travel Hub Global Visa Services"
COMPANY_EMAIL="notifications@mstravelhub.com"
COMPANY_PHONE="+94 11 234 5678"
COMPANY_WEBSITE="https://visatrack.mstravelhub.com"
APP_URL="http://localhost:8000"

# =====================================================================
# Database Connection Configuration
# =====================================================================
# Options: 'sqlite' or 'mysql'
DB_DRIVER=sqlite
DB_PATH=data/visatrack.sqlite

# MySQL Configuration (Active when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=visatrack
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# =====================================================================
# Email Provider Configuration (SMTP)
# =====================================================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_ENCRYPTION=tls
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME="Visa Portal"

# =====================================================================
# Meta WhatsApp Business Cloud API Configuration
# =====================================================================
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_API_URL=https://graph.facebook.com

# =====================================================================
# Notification Queue & Retry Policies
# =====================================================================
NOTIFICATION_PROCESS_MODE=sync
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_MINUTES=2
